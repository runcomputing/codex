+
+    assert!(buffer[(0, 0)].symbol().contains("a=T,U=1,f=32,t=d"));
+    assert_eq!(buffer[(1, 0)].diff_option, CellDiffOption::Skip);
+    assert_eq!(buffer[(1, 1)].diff_option, CellDiffOption::Skip);
