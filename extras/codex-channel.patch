+    first.terminal_render = Some(TerminalLineRender::Image {
+        columns: 0..4,
+        image: image.clone(),
+    });
+    lines.push(first);
+    for row in 1..3 {
+        let mut continuation = HyperlinkLine::new(Line::from("    "));
+        continuation.terminal_render = Some(TerminalLineRender::ImageRow {
+            columns: 0..4,
