+fn terminal_image_group_height(
+    lines: &[HyperlinkLine],
+    wrap_width: usize,
+    max_atomic_rows: u16,
+) -> Option<u16> {
+    let crate::terminal_render::TerminalLineRender::Image { columns, image } =
+        lines.first()?.terminal_render.as_ref()?
